{
  "name": "plotip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check web/src tests/browser tests/unit playwright.config.ts vite.config.ts tsconfig.json package.json .github/workflows/check.yml",
    "test": "node --experimental-strip-types --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@vercel/analytics": "2.0.1",
    "lucide": "1.54.0",
    "maplibre-gl": "6.13.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/geojson": "7946.0.16",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
